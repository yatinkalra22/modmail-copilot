{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "modmail-copilot",
  "permissions": {
    "http": {
      "domains": ["generativelanguage.googleapis.com"]
    }
  },
  "settings": {
    "global": {
      "GEMINI_API_KEY": {
        "type": "string",
        "label": "Gemini API key",
        "helpText": "Google AI Studio key used by the triage spike. Set via `devvit settings set GEMINI_API_KEY`.",
        "isSecret": true
      }
    }
  },
  "post": {
    "dir": "public",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.js"
  },
  "menu": {
    "items": [
      {
        "label": "Create a new post",
        "description": "modmail-copilot",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/on-app-install"
  },
  "scripts": {
    "dev": "node --experimental-strip-types ./tools/build.ts --watch",
    "build": "node --experimental-strip-types ./tools/build.ts --minify"
  }
}
